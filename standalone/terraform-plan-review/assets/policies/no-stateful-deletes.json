  "meta": {
    "version": "v1",
    "required_provider": "stackguardian/terraform_plan",
    "name": "no-stateful-deletes",
    "description": "Fails when the plan deletes or replaces a resource that usually holds data: databases, buckets, disks, file systems and encryption keys. Types not in the plan are skipped."
  },
